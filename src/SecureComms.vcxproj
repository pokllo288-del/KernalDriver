<?xml version="1.0" encoding="utf-8"?>
<!--
  SecureComms.vcxproj

  Visual Studio + WDK (Windows Driver Kit) project for the SecureComms driver.
  Requires Visual Studio 2019/2022 with the WDK and Spectre-mitigated libraries
  installed. Build the "Debug"/"Release" x64 configuration; the output is
  SecureComms.sys.

  This is a minimal, hand-maintained project file intended to document the
  required toolchain settings; regenerate from the WDK "Kernel Mode Driver,
  Empty (KMDF/WDM)" template if you prefer the full IDE-managed version.
-->
<Project DefaultTargets="Build" ToolsVersion="17.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{2B4C1E7A-3D5F-4A2E-9B1C-7E6D5C4B3A21}</ProjectGuid>
    <TargetVersion>Windows10</TargetVersion>
    <DriverType>WDM</DriverType>
    <Configuration>Debug</Configuration>
    <Platform>x64</Platform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <SpectreMitigation>Spectre</SpectreMitigation>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- Pull in the shared public header directory. -->
      <AdditionalIncludeDirectories>$(ProjectDir)..\inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- wdmsec.lib provides IoCreateDeviceSecure. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- Enable static driver verifier + code analysis in CI builds. -->
    <DriverSign>
      <FileDigestAlgorithm>SHA256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="Driver.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Driver.h" />
    <ClInclude Include="..\inc\SecureComms_Public.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="SecureComms.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
